{
    "$schema": "../.sitecore/schemas/ModuleFile.schema.json",
    "namespace": "Project.SitecoreXMC",
    "items": {
      "includes": [      
        {
          "name": "tenantRoot",
          "path": "/sitecore/content/Sourceved Demo",
          "scope": "SingleItem",
          "allowedPushOperations": "CreateAndUpdate"
        },
        {
          "name": "site",
          "path": "/sitecore/content/Sourceved Demo/Sourceved",
          "rules": [
            {
              "path": "/home",
              "scope": "ItemAndDescendants",
              "allowedPushOperations": "CreateOnly"
            },
            {
              "path": "/Media",
              "scope": "ItemAndChildren",
              "allowedPushOperations": "CreateAndUpdate"
            },
            {
              "path": "/Data",
              "scope": "ItemAndChildren",
              "allowedPushOperations": "CreateAndUpdate"
            },
            {
              "path": "/Dictionary",
              "scope": "ItemAndChildren",
              "allowedPushOperations": "CreateOnly"
            },
            {
              "path": "/Presentation",
              "scope": "ItemAndDescendants",
              "allowedPushOperations": "CreateAndUpdate"
            },
            {
              "path": "/Settings/Site Grouping",
              "scope": "ItemAndDescendants",
              "allowedPushOperations": "CreateOnly"
            },
            {
              "path": "/Settings",
              "scope": "ItemAndChildren",
              "allowedPushOperations": "CreateAndUpdate"
            },
            {
              "path": "*", 
              "scope": "Ignored"
            }
          ]
        }
      ]
    }
  }